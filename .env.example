# =============================================================================
# ReRout 测试环境配置
# 复制本文件为 .env 后根据实际环境修改
# =============================================================================
# 使用方式：cp .env.example .env && vim .env
# =============================================================================

# -----------------------------------------------------------------------------
# ReRout Controller
# -----------------------------------------------------------------------------
# Higress 网关地址（你的内网 Higress 实例）
HIGRESS_BASE_URL=http://your-higress:8080/v1

# 如果 Higress 需要 API Key（通常内网不需要）
HIGRESS_API_KEY=

# OpenAI/Anthropic API Key（如果需要使用外部模型，测试环境可不填）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# LLM Classifier Sidecar（意图分类服务）
# -----------------------------------------------------------------------------
# 分类模式：mock（规则匹配，不调模型）或 llm（调外部模型）
# 测试初期建议先用 mock，验证流程通畅后再切 llm
LLM_CLASSIFIER_MODE=mock

# 模型 API 地址（通过 Higress 访问小模型）
# 示例：http://higress:8080/v1/chat/completions
# 注意：这里填的是 Higress 的 chat completions 端点
LLM_CLASSIFIER_URL=

# 用于分类的模型名称（Higress 中注册的模型名）
LLM_CLASSIFIER_MODEL=qwen2.5-7b

# 模型 API Key（如果 Higress 需要认证）
LLM_CLASSIFIER_API_KEY=

# 分类请求超时（秒）
LLM_CLASSIFIER_TIMEOUT=10

# 自定义分类 Prompt（留空使用默认中文 Prompt）
# 可用占位符：{labels}（类别列表）, {text}（用户输入）
LLM_CLASSIFIER_PROMPT=

# 分类标签（逗号分隔，需与 policy_engine 映射一致）
LLM_CLASSIFIER_LABELS=code_generation,reasoning,summarization,brainstorming,open_qa,chatbot

# -----------------------------------------------------------------------------
# Intent Classifier (ReRout 内置)
# -----------------------------------------------------------------------------
# ONNX 模型文件路径（如果有 ONNX 模型）
INTENT_ONNX_PATH=
INTENT_TOKENIZER=distilbert-base-uncased

# -----------------------------------------------------------------------------
# Policy Engine
# -----------------------------------------------------------------------------
# 自定义 intent → model 映射（JSON 格式，覆盖默认值）
# 示例：
# POLICY_MODEL_MAP={"code_generation":"higress/qwen2.5-coder-7b","reasoning":"higress/deepseek-r1-67b","summarization":"higress/qwen2.5-7b","brainstorming":"higress/qwen2.5-32b","open_qa":"higress/qwen2.5-7b","chatbot":"higress/qwen2.5-7b"}
POLICY_MODEL_MAP=

# A/B 测试（默认关闭）
AB_ENABLED=false
AB_VARIANT_PCT=0.1

# Bandit 探索率
BANDIT_EPSILON=0.1

# -----------------------------------------------------------------------------
# Complexity Estimator
# -----------------------------------------------------------------------------
COMPLEXITY_ONNX_PATH=

# -----------------------------------------------------------------------------
# Memory Manager
# -----------------------------------------------------------------------------
# 是否启用对话记忆
MEMORY_ENABLED=false

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
